{
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",

  "workbench.externalBrowser": "chrome",

  "files.encoding": "utf8",
  "files.autoGuessEncoding": false,
  "files.eol": "\n",
  "files.watcherExclude": {
    "**/.git/**": true,
    "**/node_modules/**": true,
    "**/.nuxt/**": true,
    "**/.output/**": true,
    "**/dist/**": true,
    "**/.cache/**": true
  },
  "files.exclude": {
    "**/.nuxt": true,
    "**/.output": true,
    "**/dist": true,
    "**/.cache": true
  },
  "search.exclude": {
    "**/.nuxt": true,
    "**/.output": true,
    "**/dist": true,
    "**/.cache": true
  },
  "tailwindCSS.files.exclude": [
    "**/.git/**",
    "**/node_modules/**",
    "**/.nuxt/**",
    "**/.output/**",
    "**/dist/**",
    "**/.cache/**"
  ],
  "tailwindCSS.experimental.configFile": "app/assets/css/tailwind.css",

  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit",
    "source.organizeImports": "explicit"
  },
  "files.associations": {
    "*.test.tsx": "typescriptreact",
    "*.test.ts": "typescript"
  },
  "yaml.schemas": {
    "https://json.schemastore.org/github-workflow": [".github/workflows/*.yml"]
  },
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.patterns": {
    "*.tsx": "${capture}.test.tsx,${capture}.stories.tsx",
    "*.ts": "${capture}.test.ts"
  },
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  }
}
